# Dependencies
node_modules/

# Logs / editor noise
*.log
*.tsbuildinfo
.DS_Store
Thumbs.db

# Local PR-submission working copy (awesome-dsh-plugin clone + entry yml)
awesome-dsh-plugin-submission/

# tsdown intermediate: lib/client.js is the wrapped artifact that ships,
# lib/client.bundle.js is regenerated by every build — tracked would mean a
# meaningless diff (and ~620KB) on every `npm run build` (v0.19.0).
lib/client.bundle.js

# Local agent workspace (session memory, scratch files) — not part of the
# published plugin or the repo history.
.workbuddy/

# Code-audit reports are working documents, not product source: the findings they
# list are either fixed (and then guarded by scripts/verify-*.mjs) or still open in
# the issue tracker. Keeping them in the repo made them look like maintained docs.
# The authoritative copy of the 2026-09-17 report now lives in the knowledge base.
docs/code-review-*.md
